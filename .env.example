# Environment Variables

# GitHub Authentication (REQUIRED)
# Create a token at: https://github.com/settings/tokens
# Scopes needed: repo, issues, pull_requests
GH_TOKEN=ghp_your_token_here

# LLM Provider API Keys (optional — defaults to no provider)
# At least one provider is needed for code generation
#
# OpenAI
# OPENAI_API_KEY=sk-...
#
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# Wafer (default if no key set)
# WAFER_API_KEY=

# Redis Configuration (optional — defaults to docker compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging (optional)
# LOG_LEVEL=INFO
